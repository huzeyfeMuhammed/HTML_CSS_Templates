<!doctype html>
<html lang="en">
  <head>
    <%- include('partials/head', { title: 'index' }) %>
  </head>
  <body>
    <div class="page d-flex">
      <%- include('partials/sidebar', { page: 'index' }) %>
      <div class="content w-full">
        <%- include('partials/header') %>
        <h1 class="p-relative">Dashboard</h1>
        <p><%= '<b>Hello</b>' %></p>
        <div class="wrapper d-grid gap-20">
          <!-- Start Welcome Widget -->
          <div class="welcome bg-white rad-10 txt-c-mobile block-mobile">
            <div class="intro p-20 d-flex space-between bg-eee">
              <div>
                <h2 class="m-0">Welcome</h2>
                <p class="c-grey mt-5">Huzeyfe</p>
              </div>
              <img class="hide-mobile" src="./images/welcome.png" alt="" />
            </div>
            <img class="avatar" src="./images/avatar.png" alt="" />
            <div class="body txt-c d-flex p-20 mt-20 mb-20 block-mobile">
              <div>
                Huzeyfe Muhammed<span class="d-block c-grey fs-14 mt-10"
                  >Developer</span
                >
              </div>
              <div>
                10<span class="d-block c-grey fs-14 mt-10">Projects</span>
              </div>
              <div>
                0$<span class="d-block c-grey fs-14 mt-10">Earned</span>
              </div>
            </div>
            <a
              href="profile.html"
              class="visit d-block fs-14 rad-6 bg-blue c-white w-fit btn-shape"
              >Profile</a
            >
          </div>
          <!-- End Welcome Widget -->
          <!-- Start Quick Draft Widget -->
          <div class="quick-draft dash-widget">
            <h2 class="mt-0 mb-10">Quick Draft</h2>
            <p class="mt-0 mb-20 c-grey fs-15">Write A Draft For Your Ideas</p>
            <form>
              <input
                class="bg-eee rad-6 d-block w-full b-none p-10 mb-20"
                type="text"
                placeholder="Title"
              />
              <textarea
                class="bg-eee rad-6 d-block w-full b-none p-10 mb-20"
                placeholder="Your Thought"
              ></textarea>
              <input
                type="submit"
                value="Save"
                class="save btn-shape fs-14 bg-blue c-white d-block b-none w-fit"
              />
            </form>
          </div>
          <!-- End Quick Draft Widget -->
          <!-- Start Yearly Targets Widget -->
          <div class="targets dash-widget">
            <h2 class="">Yearly Targets</h2>
            <p class="">Start Yearly Targets Widget</p>
            <div class="target-row mb-20 center-flex money">
              <div class="icon center-flex">
                <i class="fa-solid fa-dollar-sign fa-lg c-blue"></i>
              </div>
              <div class="details">
                <span class="fs-14 c-grey">Money</span>
                <span class="d-block mt-5 mb-10 fw-bold">20.000$</span>
                <div class="progress p-relative">
                  <span class="bg-blue money" style="width: 50%">
                    <span class="bg-blue">50%</span>
                  </span>
                </div>
              </div>
            </div>
            <div class="target-row mb-20 center-flex projects">
              <div class="icon center-flex">
                <i class="fa-solid fa-code fa-lg c-orange"></i>
              </div>
              <div class="details">
                <span class="fs-14 c-grey">Projects</span>
                <span class="d-block mt-5 mb-10 fw-bold">20</span>
                <div class="progress p-relative">
                  <span class="bg-orange projects" style="width: 25%">
                    <span class="bg-orange">25%</span>
                  </span>
                </div>
              </div>
            </div>
            <div class="target-row mb-20 center-flex team">
              <div class="icon center-flex">
                <i class="fa-solid fa-user-group fa-lg c-green"></i>
              </div>
              <div class="details">
                <span class="fs-14 c-grey">Team</span>
                <span class="d-block mt-5 mb-10 fw-bold">10</span>
                <div class="progress p-relative">
                  <span class="bg-green team" style="width: 20%">
                    <span class="bg-green">20%</span>
                  </span>
                </div>
              </div>
            </div>
          </div>
          <!-- End Yearly Targets Widget -->
          <!-- Start Ticket Widget -->
          <div class="tickets dash-widget">
            <h2>Tickets Statistics</h2>
            <p>Everything About Support Tickets</p>
            <div class="d-flex txt-c gap-20 f-wrap">
              <div class="box p-20 rad-10 fs-13 c-grey">
                <i
                  class="fa-regular fa-rectangle-list fa-2x mb-10 c-orange"
                ></i>
                <span class="c-black d-block fw-bold fs-25 mb-5">2500</span>
                Total
              </div>
              <div class="box p-20 rad-10 fs-13 c-grey">
                <i class="fa-solid fa-spinner fa-2x mb-10 c-blue"></i>
                <span class="c-black d-block fw-bold fs-25 mb-5">500</span>
                Total
              </div>
              <div class="box p-20 rad-10 fs-13 c-grey">
                <i class="fa-regular fa-circle-check fa-2x mb-10 c-green"></i>
                <span class="c-black d-block fw-bold fs-25 mb-5">1900</span>
                Total
              </div>
              <div class="box p-20 rad-10 fs-13 c-grey">
                <i class="fa-regular fa-rectangle-xmark fa-2x mb-10 c-red"></i>
                <span class="c-black d-block fw-bold fs-25 mb-5">100</span>
                Total
              </div>
            </div>
          </div>
          <!-- End Ticket Widget -->
          <!-- Start Latest News Widget -->
          <div class="latest-news dash-widget txt-c-mobile">
            <h2>Latest News</h2>
            <div class="news-row d-flex align-center block-mobile">
              <img src="./images/news-01.png" alt="" class="mr-20 rad-6" />
              <div class="info fg-1">
                <h3 class="fs-16 mb-5">Created SASS Section</h3>
                <p class="m-0 fs-14 c-grey">New SASS Examples & Tutorials</p>
              </div>
              <div class="btn-shape bg-eee fs-13 label">3 Days Ago</div>
            </div>
            <div class="news-row d-flex align-center block-mobile">
              <img src="./images/news-02.png" alt="" class="mr-20 rad-6" />
              <div class="info fg-1">
                <h3 class="fs-16 mb-5">Changed The Design</h3>
                <p class="m-0 fs-14 c-grey">A Brand New Website Design</p>
              </div>
              <div class="btn-shape bg-eee fs-13 label">5 Days Ago</div>
            </div>
            <div class="news-row d-flex align-center block-mobile">
              <img src="./images/news-03.png" alt="" class="mr-20 rad-6" />
              <div class="info fg-1">
                <h3 class="fs-16 mb-5">Team Increased</h3>
                <p class="m-0 fs-14 c-grey">3 Developers Joined The Team</p>
              </div>
              <div class="btn-shape bg-eee fs-13 label">7 Days Ago</div>
            </div>
            <div class="news-row d-flex align-center block-mobile">
              <img src="./images/news-04.png" alt="" class="mr-20 rad-6" />
              <div class="info fg-1">
                <h3 class="fs-16 mb-5">Added Payment Gateway</h3>
                <p class="m-0 fs-14 c-grey">Many New Payment Gateways Added</p>
              </div>
              <div class="btn-shape bg-eee fs-13 label">9 Days Ago</div>
            </div>
          </div>
          <!-- End Latest News Widget -->
          <!-- Start Latest Tasks Widget -->
          <div class="tasks dash-widget">
            <h2 class="mb-20">Latest Tasks</h2>
            <div class="task-row between-flex mb-10">
              <div class="info fg-1">
                <h3 class="fs-15 mt-10 mb-5">Record One New Video</h3>
                <p class="m-0 mb-10 fs-14 c-grey">
                  Record Python Create Exe Project
                </p>
              </div>
              <i class="fa-regular fa-trash-can delete"></i>
            </div>
            <div class="task-row between-flex mb-10">
              <div class="info fg-1">
                <h3 class="fs-15 mt-0 mb-5">Write Article</h3>
                <p class="m-0 mb-10 fs-14 c-grey">
                  Write Low Level vs High Level Languages
                </p>
              </div>
              <i class="fa-regular fa-trash-can delete"></i>
            </div>
            <div class="task-row between-flex mb-10">
              <div class="info fg-1">
                <h3 class="fs-15 mb-5">Finish Project</h3>
                <p class="m-0 mb-10 fs-14 c-grey">

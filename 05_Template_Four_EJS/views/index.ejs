            </div>
            <div class="item between-flex mb-10 pt-15 pb-15">
              <span class="">Design</span>
              <span class="btn-shape bg-eee fs-13">140</span>
            </div>
            <div class="item between-flex mb-10 pt-15 pb-15">
              <span class="">Logic</span>
              <span class="btn-shape bg-eee fs-13">135</span>

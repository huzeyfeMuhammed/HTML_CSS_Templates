              </li>
              <li class="d-flex align-center mt-15 mb-20 p-relative">
                <div class="pl-15 ml-40 green">
                  <p class="fw-bold fs-15 mb-10">Check My Projects</p>
                  <div class="mb-15 fs-14 c-grey">26/10/2022 - 12:00am</div>
                </div>
              </li>
              <li class="d-flex align-center mt-15 mb-20 p-relative">
                <div class="pl-15 ml-40 orange">
                  <p class="fw-bold fs-15 mb-10">Call All My Clients</p>
                  <div class="mb-15 fs-14 c-grey">05/11/2022 - 12:00am</div>

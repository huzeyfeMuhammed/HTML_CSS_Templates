              <li class="d-flex align-center mt-15 mb-20 p-relative">
                <div class="pl-15 ml-40 blue">
                  <p class="fw-bold fs-15 mb-10">
                    Finish The Development Workshop
                  </p>
                  <div class="mb-15 fs-14 c-grey">20/12/2022 - 12:00am</div>
                </div>
              </li>
            </ul>
          </div>
          <!-- End Reminders -->
          <!-- Start lastest Posts -->
          <div class="latest-posts dash-widget">
            <h2>Latest Post</h2>
            <div class="profil bb-solid pt-20 pb-20 d-flex align-center">
              <img class="avatar w-50 mr-10" src="./images/avatar.png" alt="" />
              <div>
                <span class="d-block fw-bold fs-15 mb-5">Huzeyfe Muhammed</span>

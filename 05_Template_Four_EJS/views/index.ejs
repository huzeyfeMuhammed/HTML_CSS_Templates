              </p>
            </div>
            <div class="stats pt-20 between-flex c-grey">
              <div class="">
                <i class="fa-regular fa-heart"></i> <span>1.5 K</span>
              </div>
              <div><i class="fa-regular fa-comments"></i> <span>500</span></div>
            </div>
          </div>
          <!-- End lastest Posts -->
          <!-- Start Social Media Stats Posts -->
          <div class="social-media dash-widget">
            <h2>Social Media Stats</h2>
            <div class="box twitter p-relative between-flex p-15 mb-15">
              <i
                class="fa-brands fa-twitter fa-2x c-white h-full center-flex p-relative"
              ></i>
              <span>90K Followers </span>
              <a class="fs-13 c-white btn-shape" href="#">Follow</a>
            </div>
            <div class="box facebook p-relative between-flex p-15 mb-15">
              <i
                class="fa-brands fa-facebook fa-2x c-white h-full center-flex p-relative"
              ></i>
              <span>900K Like </span>
              <a class="fs-13 c-white btn-shape" href="#">Like</a>
            </div>
            <div class="box youtube p-relative between-flex p-15 mb-15">
              <i
                class="fa-brands fa-youtube fa-2x c-white h-full center-flex p-relative"
              ></i>
              <span>2K Sub </span>
              <a class="fs-13 c-white btn-shape" href="#">Subsctibe</a>
            </div>
            <div class="box linkedin p-relative between-flex p-15 mb-15">

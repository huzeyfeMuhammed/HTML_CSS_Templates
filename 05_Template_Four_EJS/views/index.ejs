                </div>
                <div class="bg-eee btn-shape fs-13">8.9mb</div>
              </li>
            </ul>
          </div>
          <!-- End Latest Uploads -->
          <!-- Start Last Project -->
          <div class="last-project dash-widget p-relative">
            <h2>Last Project Progress</h2>
            <img src="./images/project.png" alt="" class="hide-mobile" />
            <div class="project p-relative">
              <div class="p-relative pb-20 mb-10 ml-40 done">
                Got The Project
              </div>
              <div class="p-relative pb-20 mb-10 ml-40 done">
                Started The Project
              </div>
              <div class="p-relative pb-20 mb-10 ml-40 done">
                The Project About To Finish
              </div>
              <div class="p-relative pb-20 mb-10 ml-40 curent">
                Test The Project
              </div>
              <div class="p-relative mb-10 ml-40 pr-10">
                Finish The Project & Get Money
              </div>
            </div>
          </div>
          <!-- End Last Project -->
          <!-- Start Reminders -->
          <div class="reminders dash-widget p-relative">
            <h2>Reminders</h2>
            <ul class="p-relative">
              <li class="d-flex align-center mt-15 mb-20 p-relative">
                <div class="pl-15 ml-40 red">
                  <p class="fw-bold fs-15 mb-10">Check My Tasks List</p>
                  <div class="mb-15 fs-14 c-grey">28/09/2022 - 12:00am</div>
